{
  "name": "@mathematic-inc/site",
  "version": "1.0.0",
  "private": true,
  "description": "Mathematic Inc. research notes and repository catalog",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "catalog:check": "node scripts/check-catalog.mjs",
    "check": "npm run build && npm test && npm run test:browser",
    "dev": "npm run build && node --watch scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/site.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6"
  },
  "engines": {
    "node": ">=26.8.2"
  }
}
