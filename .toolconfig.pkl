amends
  "package://github.com/mathematic-inc/toolconfig/releases/download/v2026.11.6/toolconfig@2026.11.6#/ToolConfig.pkl"

root = true

toolconfig {
  `extends` =
    List(new Repository {
      git = "https://github.com/mathematic-inc/toolconfig-config.git"
      rev = "56ddc9b031a44165668fc9ed41f90e62a4e31ea5"
      path = "profiles/org/.toolconfig.pkl"
    })
}

sections {
  ["*"] {
    oxlint {
      rules {
        ["typescript/prefer-readonly-parameter-types"] {
          "deny"
          new {
            // Library types have writable members that this repository cannot change.
            allow =
              List(
                new Dynamic {
                  from = "lib"
                  name =
                    List(
                      "Element",
                      "Error",
                      "Event",
                      "HTMLElement",
                      "KeyboardEvent",
                      "RegExpExecArray",
                      "URL",
                    )
                },
                new Dynamic {
                  from = "package"
                  package = "playwright"
                  name = List("PlaywrightTestArgs")
                },
                new Dynamic {
                  from = "package"
                  package = "playwright-core"
                  name = List("Page", "Route")
                },
                new Dynamic {
                  from = "package"
                  package = "@types/node"
                  name = List("IncomingMessage", "ServerResponse")
                },
              )
          }
        }
      }
    }
  }
}
